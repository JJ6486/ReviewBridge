{
  "name": "review-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PoC: can OpenAI's native web search reliably find and aggregate product reviews from 3-5 selected sources at a reasonable API cost?",
  "scripts": {
