# ============================================================
# ReviewBridge PoC — environment configuration
# Copy to .env and fill in. .env is git-ignored. Keys are never logged.
# ============================================================

# Required. OpenAI API key (Responses API + web search).
OPENAI_API_KEY=

# Cost-conscious model that supports the Responses API `web_search` tool.
# Examples: gpt-5.6-luna, gpt-4.1-mini, gpt-4.1
OPENAI_MODEL=gpt-5.6-luna

# After discovery, at most this many sources are collected/analysed (3-5).
MAX_SOURCES=5

# Log verbosity: debug | info | warn | error
LOG_LEVEL=info

# Port for the web UI (`npm run dev`). Default 3000.
# PORT=3000

# ---- optional ------------------------------------------------
# Target number of deliberate review-focused search queries (3-6, default 5).
# SEARCH_QUERIES=5

# ---- review source registry -----------------------------------
# Persist validated review sources per product (data/review-source-registry.json)
# and reuse them on later runs instead of re-discovering via web search.
# REGISTRY_ENABLED=true
# REGISTRY_PATH=data/review-source-registry.json
# A trusted source older than this is re-verified before reuse, not reused blindly.
# REGISTRY_TTL_HOURS=168
# Known sources must yield at least this many usable matches to skip web discovery.
# REGISTRY_MIN_SOURCES=2
